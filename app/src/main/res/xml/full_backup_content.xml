<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 counterpart of data_extraction_rules.xml: with allowBackup="false" this is
     never consulted, but the platform requires the pair to be declared together. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
